// 模板系统那一页的数据：左原文、右展开两栏并排，同一种替换同一种颜色
// （色号语义见调色板的 m1…m14）。用在：== 题面 - 语法 - 模板系统。
#import "style.typ": *

// 左栏：statement.md 原文，用 band() 标出会被模板替换的部分
// 右侧这一格展开成 12 行，这里补 12 行空行，下面才继续逐行对齐
#let m-left = mtext(
  "
## 输入格式

<m1>{{ statement.input_file() }}</m1>

输入的第一行包含两个正整数 $n, m$。

共 <m2>{{ problem.data | length }}</m2> 个测试点。

<m3>{{ tools.cases([1,2,3,5,6,7,114,514]) }}</m3>

## 输出格式

<m4>{{ s.output_file() }}</m4>

<m5>{{ sample.text(1) }}</m5>












## 样例 2

<m6>{{ sample.file(2) }}</m6>",
)


// 右栏：模板展开之后的样子，与左栏同色对应
#let m-right = mtext(
  "
